@@ -0,0 +1,95 @@
+"""Doubao multimodal embedder (Volcengine Ark /embeddings/multimodal endpoint).
+
+Added 2026-06-28 to unblock the banking_knowledge RAG domain. Our Ark-only endpoint
+serves no OpenAI/OpenRouter text-embedding model, but it DOES serve doubao multimodal
+embedding models (e.g. doubao-embedding-vision-251215). Those models reject the
+standard OpenAI /embeddings route ("does not support this api") and must be called
+via /embeddings/multimodal with input items of the form {"type": "text", "text": ...}.
+We send text-only inputs (one call per text) and read data.embedding.
+
+Creds come from env (set by the same .env as agent/user): OPENAI_API_KEY/_BASE_URL or
+META_AGENT_API_KEY/_API_BASE. Embeddings are cached by tau2's EmbeddingsCache, so this
+endpoint is hit only when warming a KB for a new (doc-set, embedder) combination.
+"""
+
+import json
+import os
+import time
+import urllib.request
+from concurrent.futures import ThreadPoolExecutor
+from typing import List
+
+import numpy as np
+
+from tau2.knowledge.embedders.base import BaseEmbedder
+
+DEFAULT_DOUBAO_EMBED_MODEL = "doubao-embedding-vision-251215"
+
+
+class DoubaoVisionEmbedder(BaseEmbedder):
+    """Embedder using a doubao multimodal embedding model on Ark (text inputs only)."""
+
+    def __init__(
+        self,
+        model: str = DEFAULT_DOUBAO_EMBED_MODEL,
+        api_key: str = None,
+        base_url: str = None,
+        max_workers: int = 3,
+        **kwargs,  # tolerate extra params (e.g. query_instruction) passed by callers
+    ):
+        self.model = model
+        self.api_key = (
+            api_key or os.getenv("OPENAI_API_KEY") or os.getenv("META_AGENT_API_KEY")
+        )
+        base = (
+            base_url
+            or os.getenv("OPENAI_BASE_URL")
+            or os.getenv("OPENAI_API_BASE")
+            or os.getenv("META_AGENT_API_BASE")
+        )
+        if not self.api_key or not base:
+            raise ValueError(
+                "DoubaoVisionEmbedder: missing api key / base url "
+                "(set OPENAI_API_KEY + OPENAI_BASE_URL, or META_AGENT_API_KEY/_API_BASE)"
+            )
+        self.url = base.rstrip("/") + "/embeddings/multimodal"
+        self.max_workers = max(1, int(max_workers))
+
+    def _embed_one(self, text: str, retries: int = 4) -> list:
+        body = json.dumps(
+            {"model": self.model, "input": [{"type": "text", "text": text or " "}]}
+        ).encode("utf-8")
+        last = None
+        for attempt in range(retries):
+            try:
+                req = urllib.request.Request(
+                    self.url,
+                    data=body,
+                    headers={
+                        "Authorization": f"Bearer {self.api_key}",
+                        "Content-Type": "application/json",
+                    },
+                )
+                resp = json.loads(urllib.request.urlopen(req, timeout=60).read())
+                d = resp.get("data")
+                if isinstance(d, dict) and "embedding" in d:
+                    return d["embedding"]
+                if isinstance(d, list) and d and "embedding" in d[0]:
+                    return d[0]["embedding"]
+                raise ValueError(f"no embedding in response: {str(resp)[:200]}")
+            except Exception as e:  # transient (rate-limit / network): backoff + retry
+                last = e
+                time.sleep(1.5 * (attempt + 1))
