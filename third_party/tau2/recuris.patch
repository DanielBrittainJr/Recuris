+                already_nudged = True
+            for tc in getattr(m, "tool_calls", None) or []:
+                if getattr(tc, "name", None) in self._WRITE_TOOLS:
+                    return assistant_message, state
+        if already_nudged:
+            return assistant_message, state  # gave one forcing nudge already; don't hammer
+        # (c) a genuine customer confirmation exists somewhere (exclude our own SYSTEM CHECK messages)
+        confirmed = any(
+            isinstance(m, UserMessage)
+            and m.content
+            and not m.content.startswith("[SYSTEM CHECK")
+            and self._CONFIRM_RE.search(m.content)
+            for m in state.messages
+        )
