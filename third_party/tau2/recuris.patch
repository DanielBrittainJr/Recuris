@@ -0,0 +1,116 @@
+"""Write-review checkpoint — per-tool exemplar memory delivered at call time (TAU2_WRITE_REVIEW=1).
+
+AGENT-SIDE by design: when the agent produces a tool-call message containing an unreviewed WRITE
+call, the call is NOT returned to the orchestrator. Instead the (call + synthetic review result)
+pair is appended to the agent's OWN message state, and the agent regenerates with the tool's usage
+guide in view; only the post-review call ever reaches the orchestrator/environment. This keeps the
+official trajectory replay-clean (the evaluator re-executes every mutating call in the trajectory
+and compares outputs — an orchestrator-side bounce would break that).
+
+Memory framing: content = ACTION-RESULT exemplars (correct call with ABSTRACT placeholder ids +
+common mistakes with reasons — anti-anchoring, no task answers, derived from tool contracts and
+failure-mode analysis); delivery = structural checkpoint at the moment of action (once per call).
+
+Safety fuses (from prior iterations' lessons):
+- WRITE tools only (reads are frequent and harmless).
+- "If already correct, re-submit UNCHANGED" (vs weak-model self-doubt flip-flops).
+- Abstract ids in examples (vs the Iter-6 param-anchoring failure).
+"""
+
+from __future__ import annotations
+
+REVIEW_MARKER = "[WRITE REVIEW CHECKPOINT"
+
+WRITE_REVIEW_DOCS = {
+    "exchange_delivered_order_items": (
+        "Purpose: swap delivered items for DIFFERENT variants of the SAME product.\n"
+        "Correct example: the customer exchanges a small lamp for the medium one. From the order\n"
+        "details the current small lamp has item id A; from get_product_details the medium\n"
+        "variant has item id B. Then: item_ids=[A], new_item_ids=[B]. A and B MUST be different.\n"
+        "Common mistakes:\n"
+        "- new_item_ids identical to item_ids (e.g. [A] -> [A]): exchanges nothing, always wrong.\n"
+        "  new_item_ids are the REPLACEMENT variant ids, looked up via get_product_details.\n"
+        "- Inventing an id that never appeared in any earlier tool result.\n"
+        "- Wrong pairing: new_item_ids[k] must be the replacement for item_ids[k] (same position,\n"
+        "  same product, different variant).\n"
+        "- payment_method_id must be an EXISTING method id from the user or order details."
+    ),
+    "modify_pending_order_items": (
+        "Purpose: change pending-order items to DIFFERENT variants of the SAME product.\n"
+        "Correct example: change a blue shirt (item id A, from order details) to the red variant\n"
+        "(item id B, from get_product_details): item_ids=[A], new_item_ids=[B]. A != B.\n"
+        "Common mistakes:\n"
+        "- new_item_ids identical to item_ids: modifies nothing, always wrong.\n"
+        "- Ids not present in earlier tool results (never invent ids).\n"
+        "- Wrong position pairing: new_item_ids[k] replaces item_ids[k], same product.\n"
+        "- payment_method_id must be an EXISTING method id from user/order details."
+    ),
+    "return_delivered_order_items": (
+        "Purpose: return delivered items for a refund.\n"
+        "Correct example: return the water bottle (item id A) and the pet bed (item id B) from\n"
+        "order #W...: order_id='#W...', item_ids=[A, B], payment_method_id=<the ORDER'S ORIGINAL\n"
+        "payment method, or an existing gift card>.\n"
+        "REFUND-DESTINATION RULE (frequent failure — check the order's payment_history FIRST):\n"
+        "  A refund may ONLY go to the order's original payment method, or to a gift card already\n"
+        "  on the account. It CANNOT go to a different card just because the customer asks.\n"
+        "  X If the order was PAID BY GIFT CARD and you set payment_method_id to a credit card,\n"
+        "    the tool fails: 'Payment method should be the original payment method'. So if the\n"
+        "    customer asks for the refund on their credit card but the order was paid by gift\n"
+        "    card, tell them up front it must go back to the gift card — do not attempt the\n"
+        "    credit-card refund.\n"
+        "  OK Read payment_history of the order; use that same payment_method_id (or an existing\n"
+        "    gift card if the customer accepts).\n"
+        "Other common mistakes:\n"
+        "- item_ids not taken verbatim from the order details; each item_id must belong to THIS order."
+    ),
+    "cancel_pending_order": (
+        "Purpose: cancel one pending order.\n"
+        "Correct example: cancel_pending_order(order_id='#W...', reason='no longer needed').\n"
+        "Common mistakes:\n"
+        "- reason MUST be exactly 'no longer needed' or 'ordered by mistake' (no other wording).\n"
+        "- order_id must start with '#' and come from the order details.\n"
+        "- One call cancels ONE order; cancel each order separately."
+    ),
+    "modify_pending_order_address": (
+        "Purpose: change the shipping address of one pending order.\n"
+        "Correct example: copy the field FORMAT from addresses you already saw in the user/order\n"
+        "details (address1, address2, city, state as 2-LETTER code like 'NY', country 'USA', zip).\n"
+        "Common mistakes:\n"
+        "- state written out in full ('New York') instead of the 2-letter code ('NY') used\n"
+        "  everywhere in the system data.\n"
+        "- missing zip or address2 (use '' if none)."
+    ),
+    "modify_user_address": (
+        "Purpose: change the user's default address.\n"
+        "Correct example: same field format as existing addresses in the system: state as the\n"
+        "2-LETTER code (e.g. 'NY', 'CO'), country 'USA', zip included, address2='' if none.\n"
+        "Common mistakes:\n"
+        "- state written out in full ('New York') instead of 'NY'.\n"
+        "- fields copied from customer speech without normalizing to the system format."
+    ),
+    "modify_pending_order_payment": (
+        "Purpose: switch the payment method of one pending order.\n"
+        "Correct example: payment_method_id=<an EXISTING method id from the user's profile, e.g.\n"
+        "seen in get_user_details>, order_id from the order details.\n"
+        "Common mistakes:\n"
+        "- payment_method_id that does not exist in the user's profile (never invent ids)."
+    ),
+}
+
+GENERIC_DOC = (
+    "Verify every argument value against the tool description and the data you retrieved earlier "
+    "in this conversation. Never invent identifier values."
+)
+
+
+def build_review_text(write_tool_names: list[str]) -> str:
+    docs = []
+    for name in write_tool_names:
+        docs.append(f"## {name} usage guide\n{WRITE_REVIEW_DOCS.get(name, GENERIC_DOC)}")
+    return (
+        f"{REVIEW_MARKER} - from the system, not the customer] This call was NOT executed. "
+        "Before it runs, review your call against the usage guide below.\n"
+        "- If your call is already correct, submit the SAME tool call again, completely unchanged.\n"
+        "- If you spot a mistake, submit the corrected tool call instead.\n"
+        "Your next tool call will be executed directly.\n\n" + "\n\n".join(docs)
+    )
