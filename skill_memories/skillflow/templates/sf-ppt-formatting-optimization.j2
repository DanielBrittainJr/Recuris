## MANDATORY SELF-CHECK GATE (run before you finish — do NOT declare done while it prints any PROBLEM)
As your FINAL step, create this EXACT script as `/root/verify_output.py` (set OUT to your real output path),
run `python3 /root/verify_output.py`, and FIX every line it flags, then re-run until it prints "ALL PASS".
This is a hard gate: a weak model reliably drops ONE formatting requirement per run (a:ea, a:cs, run-level
size, or box width); this script names exactly which one so you cannot ship it unnoticed.
```python
import zipfile, re, xml.etree.ElementTree as ET
OUT = "/root/REPLACE_WITH_YOUR_OUTPUT.pptx"
NS = {"a": "http://schemas.openxmlformats.org/drawingml/2006/main"}
z = zipfile.ZipFile(OUT)
pres = ET.fromstring(z.read("ppt/presentation.xml"))
SW = int(pres.find(".//{*}sldSz").get("cx"))   # sldSz is in the presentationml ns, not drawingml
probs, maxw = [], 0
for nm in sorted(n for n in z.namelist() if re.match(r"ppt/slides/slide\d+\.xml$", n)):
    sl = ET.fromstring(z.read(nm))
    for ext in sl.findall(".//a:xfrm/a:ext", NS):
        maxw = max(maxw, int(ext.get("cx") or 0))
    for p in sl.findall(".//a:p", NS):
        txt = "".join(t.text or "" for t in p.findall(".//a:t", NS)).strip()
        if not txt:
            continue
        ppr = p.find("a:pPr", NS)
        if ppr is None or ppr.get("algn") != "ctr":
            probs.append(f"{nm} para '{txt[:24]}': NOT centered (set paragraph pPr algn='ctr' if the spec asks for center)")
        for r in p.findall(".//a:r", NS):
            rpr = r.find("a:rPr", NS)
            tag = txt[:24]
            if rpr is None:
                probs.append(f"{nm} run '{tag}': NO rPr (style not on the run)"); continue
            _sz = rpr.get("sz")
            if not _sz or not (100 <= int(_sz) <= 40000):
                probs.append(f"{nm} run '{tag}': sz={_sz} INVALID (font size on the RUN rPr must be centipoints, e.g. 1500 for 15pt; not 0, not an EMU box dimension)")
            if rpr.get("b") not in (None, "0"):
                probs.append(f"{nm} run '{tag}': b='{rpr.get('b')}' NOT cleared (set b='0' if spec says bold off)")
            if rpr.get("i") not in (None, "0"):
                probs.append(f"{nm} run '{tag}': i='{rpr.get('i')}' NOT cleared (set i='0' if spec says italic off)")
            faces = {}
            for f in ("latin", "ea", "cs"):
                el = rpr.find("a:" + f, NS)
                if el is None:
                    probs.append(f"{nm} run '{tag}': MISSING a:{f}" + (" (python-pptx font.name skips a:ea/a:cs!)" if f != "latin" else ""))
                else:
                    faces[f] = el.get("typeface")
            if len(set(faces.values())) > 1:
                probs.append(f"{nm} run '{tag}': latin/ea/cs typefaces DIFFER {faces}")
if maxw < 0.9 * SW:
    probs.append(f"widest text box {maxw} < 0.9*slide_width {int(0.9*SW)} — widen the caption box(es)")
print("SELF-CHECK:", "ALL PASS" if not probs else str(len(probs)) + " PROBLEMS:")
for p in probs:
    print("  FIX:", p)
```

