```python
import zipfile, io, re, csv, os, json
from openpyxl import load_workbook
RESULT="/root/results.pptx"; INPUT="/root/input.pptx"
ALIAS="/root/label_aliases.csv"; LOCATOR="/root/live_matrix_locator.json"
PREFER=('final','approved','live','current'); IGNORE=('archive','archived','superseded','draft','obsolete')
UP=re.compile(r'([A-Za-z0-9]+)\s+to\s+([A-Za-z0-9]+)\s*=\s*([0-9]+(?:\.[0-9]+)?)',re.I)
def norm(t): return ''.join(c.lower() for c in str(t) if c.isalnum())
def isf(v): return isinstance(v,str) and v.startswith('=')
def tm(v,t): return v is not None and norm(t) in norm(v)
def col(i):
    s=''
    while i>0: i,r=divmod(i-1,26); s=chr(65+r)+s
    return s
def slide_target(p):
    ch=[]; z=zipfile.ZipFile(p)
    for n in z.namelist():
        if re.match(r'ppt/slides/slide\d+\.xml$',n):
            t=z.read(n).decode('utf-8','ignore')
            for m in re.findall(r'<a:t>(.*?)</a:t>',t,re.S):
                for pt in re.split(r'\|\||\n',m):
                    if pt.strip(): ch.append(pt.strip())
    best=None; bs=None
    for i,c in enumerate(ch):
        m=UP.search(c)
        if not m: continue
        lo=c.lower(); s=0
        if any(k in lo for k in PREFER): s+=5
        if any(k in lo for k in IGNORE): s-=5
        key=(s,-i)
        if bs is None or key>bs: best=(m.group(1),m.group(2),float(m.group(3))); bs=key
    return best
def resolve(a,b):
    if not os.path.exists(ALIAS): return a,b
    mp={}
    for r in csv.DictReader(open(ALIAS,newline='',encoding='utf-8')): mp[norm(r['note_token'])]=r['workbook_label']
    return mp.get(norm(a),a), mp.get(norm(b),b)
def mtitle():
    if os.path.exists(LOCATOR):
        try: return json.load(open(LOCATOR,encoding='utf-8')).get('matrix_title')
        except Exception: return None
    return None
def embs(p):
    z=zipfile.ZipFile(p); return [n for n in z.namelist() if n.startswith('ppt/embeddings/') and n.endswith('.xlsx')]
def wbk(p,name,do): return load_workbook(io.BytesIO(zipfile.ZipFile(p).read(name)),data_only=do)
def cands(ws,ft,tt):
    out=[]
    for ar in range(1,ws.max_row+1):
        for ac in range(1,ws.max_column+1):
            rl={}; r=ar+1
            while r<=ws.max_row and ws.cell(r,ac).value not in (None,''): rl[r]=ws.cell(r,ac).value; r+=1
            cl={}; c=ac+1
            while c<=ws.max_column and ws.cell(ar,c).value not in (None,''): cl[c]=ws.cell(ar,c).value; c+=1
            fr=[r for r,v in rl.items() if tm(v,ft)]; tr=[r for r,v in rl.items() if tm(v,tt)]
            fc=[c for c,v in cl.items() if tm(v,ft)]; tc=[c for c,v in cl.items() if tm(v,tt)]
            if fr and tr and fc and tc:
                d=(fr[0],tc[0]); iv=(tr[0],fc[0])
                if ws.cell(*d).value is not None and ws.cell(*iv).value is not None:
                    ti=ws.cell(ar-1,ac).value if ar-1>=1 else None
                    out.append((d,iv,ti))
    return out
def locate(p,ft,tt,mt):
    best=None; bs=None
    for e in embs(p):
        w=wbk(p,e,False)
        for ws in w.worksheets:
            for (d,iv,ti) in cands(ws,ft,tt):
                tl=(str(ti) if ti is not None else '').lower()
                if mt: s=100 if norm(ti)==norm(mt) else -100
                else:
                    s=0
                    if any(k in tl for k in PREFER): s+=5
                    if any(k in tl for k in IGNORE): s-=5
                if bs is None or s>bs: best=(e,ws.title,d,iv); bs=s
    return best
probs=[]
tgt=slide_target(RESULT)
if not tgt: probs.append("no FINAL/approved rate line found on the slide")
else:
    ft,tt,rate=tgt; ft,tt=resolve(ft,tt)
    loc=locate(RESULT,ft,tt,mtitle())
    if not loc: probs.append(f"could not locate the {ft}->{tt} matrix in any embedding")
    else:
        e,sh,d,iv=loc
        wd=wbk(RESULT,e,True); ws=wd[sh]
        D=ws.cell(*d).value; I=ws.cell(*iv).value
        dref=col(d[1])+str(d[0]); iref=col(iv[1])+str(iv[0])
        if D is None: probs.append(f"target DIRECT cell {sh}!{dref} reads None under data_only=True -- cached value MISSING; the grader will read None here")
        elif not isinstance(D,(int,float)): probs.append(f"{sh}!{dref} is not a number: {D!r}")
        elif abs(D-rate)>1e-4: probs.append(f"{sh}!{dref}={D} != slide FINAL value {rate}")
        if isinstance(I,(int,float)):
            if isinstance(D,(int,float)) and abs(D*I-1)>2e-3: probs.append(f"inverse {sh}!{iref}={I} is not the reciprocal of {D}")
        else:
            wf=wbk(RESULT,e,False); inv=wf[sh].cell(*iv).value
            if not (isf(inv) and re.search(r'(ROUND\()?1/'+dref+r'(,\d+)?\)?',str(inv).replace(' ','').replace('$','').upper())):
                probs.append(f"inverse {sh}!{iref} is neither a cached number nor a 1/{dref} formula")
        inf=wbk(INPUT,e,False); ouf=wbk(RESULT,e,False); ins={}; ous={}
        for s in inf.sheetnames:
            iw=inf[s]; ow=ouf[s]
            for r in range(1,iw.max_row+1):
                for c in range(1,iw.max_column+1):
                    if isf(iw.cell(r,c).value): ins[(s,r,c)]=str(iw.cell(r,c).value).replace(' ','').replace('$','').upper()
                    if isf(ow.cell(r,c).value): ous[(s,r,c)]=str(ow.cell(r,c).value).replace(' ','').replace('$','').upper()
        if ins!=ous: probs.append("some input formula cells were changed or dropped (every formula must stay a formula)")
        ind=wbk(INPUT,e,True); oud=wbk(RESULT,e,True)
        for s in ind.sheetnames:
            iw=ind[s]; ow=oud[s]
            for r in range(1,max(iw.max_row,ow.max_row)+1):
                for c in range(1,max(iw.max_column,ow.max_column)+1):
                    if s==sh and (r,c) in (d,iv): continue
                    a=iw.cell(r,c).value; b=ow.cell(r,c).value
                    if isinstance(a,(int,float)) and isinstance(b,(int,float)):
                        if abs(a-b)>=1e-6: probs.append(f"unrelated cell {s}!{col(c)}{r} changed {a}->{b}")
                    elif (str(a).strip() if a is not None else None)!=(str(b).strip() if b is not None else None):
                        probs.append(f"unrelated cell {s}!{col(c)}{r} changed {a!r}->{b!r}")
        for o in embs(RESULT):
            if o!=e and zipfile.ZipFile(INPUT).read(o)!=zipfile.ZipFile(RESULT).read(o):
                probs.append(f"other embedding {os.path.basename(o)} changed (it must stay byte-identical)")
probs=list(dict.fromkeys(probs))
print("SELF-CHECK:", "ALL PASS" if not probs else str(len(probs))+" PROBLEMS:")
for p in probs: print("  FIX:", p)
