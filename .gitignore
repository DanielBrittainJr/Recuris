# Credentials. The only rule in this file that matters more than the others.
.env
.env.*

# Third-party checkouts, fetched by third_party/*/setup.sh and never committed.
/external/

# Generated arm configs. They are rendered per run, and they name your own
# endpoint and paths; regenerate rather than commit.
/configs/*/generated/

# Run artefacts. A campaign produces gigabytes; none of it belongs in git.
/runs/
/jobs/
/ma_runs/
/tb21_runs/
/logs/
/tau2data/
*.jsonl.gz

# Caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.embed_cache/
.recuris_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Test scratch
/testtmp_*/
.pytest_tmp/

# Environments and build output
.venv/
venv/
dist/
build/
*.egg-info/

# Editors and platforms
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs. Explicit rather than implied: a stray log is how a transcript with an
# endpoint URL and an auth header ends up in a public repository.
*.log
*.err
*.out
*.stackdump
